{
  "name": "minpdf",
  "version": "0.1.0",
  "description": "Cross-language, zero-runtime-dependency PDF generation powered by one C11 file",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actiledev/minpdf.git",
    "directory": "bindings/javascript"
  },
  "homepage": "https://github.com/actiledev/minpdf#readme",
  "bugs": {
    "url": "https://github.com/actiledev/minpdf/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:wasm": "sh build-wasm.sh",
    "build": "npm run build:wasm && tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "test:all": "npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
